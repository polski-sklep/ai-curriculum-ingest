# =============================================================================
# AI Curriculum Ingest — environment variables
# Copy this file to .env and fill in real values. .env is in .gitignore.
# =============================================================================

# --- Telegram ----------------------------------------------------------------
# Create a bot with @BotFather → /newbot → copy the token here.
TELEGRAM_BOT_TOKEN=

# Numeric Telegram user ID authorised to use this bot.
# DM @userinfobot to find your own. Integer, no quotes.
TELEGRAM_ALLOWED_USER_ID=

# --- Anthropic ---------------------------------------------------------------
# https://console.anthropic.com/ → API Keys → Create
ANTHROPIC_API_KEY=
